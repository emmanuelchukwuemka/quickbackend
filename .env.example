# Server Configuration
PORT=5000
DATABASE_URL=postgres://username:password@hostname:5432/quick_backend
JWT_SECRET=your_super_secret_jwt_key

# Twilio Configuration (set these to send real SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Mail Configuration
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Admin Panel — seeds the one and only admin account on first startup (only
# runs while admin_users is empty; ignored after that, so it's safe to leave
# set). There is no self-service admin signup. To add more admins after the
# first login, use the panel's Users & Roles page.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
