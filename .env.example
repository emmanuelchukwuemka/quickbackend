# Server Configuration
PORT=5000
DATABASE_URL=postgres://username:password@hostname:5432/quick_backend
JWT_SECRET=your_super_secret_jwt_key

# Twilio Configuration (set these to send real SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Mail Configuration
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Admin Panel — seeds the one and only admin account on first startup (only
# runs while admin_users is empty; ignored after that, so it's safe to leave
# set). There is no self-service admin signup. To add more admins after the
# first login, use the panel's Users & Roles page.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Paystack — driver wallet top-ups and passenger ride payments. Use a
# sk_test_/pk_test_ key pair while developing; switch to sk_live_/pk_live_
# only once the webhook URL below is configured in the Paystack dashboard.
# Webhook URL to set in the Paystack dashboard: <your-domain>/api/payments/gateway/webhook
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
